{
  "expo": {
    "name": "Hearth",
    "slug": "hearth",
    "scheme": "hearth",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chaseholroyd.family",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Hearth lets you pick photos to share with your family.",
        "NSPhotoLibraryAddUsageDescription": "Hearth saves family photos to your phone when you tap Save to my phone.",
        "NSCameraUsageDescription": "Hearth can take a photo to share with your family.",
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "com.chaseholroyd.family",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#F7F7F4" },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "hearth.family", "pathPrefix": "/join" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": { "favicon": "./assets/favicon.png", "output": "single", "bundler": "metro" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      ["expo-image-picker", { "photosPermission": "Hearth lets you pick photos to share with your family." }],
      ["expo-media-library", { "photosPermission": "Hearth saves family photos to your phone.", "savePhotosPermission": "Hearth saves family photos to your phone.", "isAccessMediaLocationEnabled": false }],
      "expo-notifications",
      "expo-status-bar",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#F7F7F4", "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#131210" } }]
    ],
    "experiments": { "typedRoutes": false, "reactCompiler": true },
    "owner": "thefreighttrains-team",
    "runtimeVersion": { "policy": "sdkVersion" },
    "updates": { "url": "https://u.expo.dev/676e8cec-57a6-472f-9086-9a9318eaf556" },
    "extra": { "eas": { "projectId": "676e8cec-57a6-472f-9086-9a9318eaf556" } }
  }
}
